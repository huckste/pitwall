@page "/"
@inject HttpClient Http
@inject FollowStore Follows

<PageTitle>Pitwall</PageTitle>

@if (error is not null)
{
  <div class="state state-error">
    <strong>Couldn't load results.</strong>
    <span>Is the Go API running on :8080? (@error)</span>
  </div>
}
else if (all is null)
{
  <div class="state">Loading…</div>
}
else if (editing || Watched.Count == 0)
{
  <FollowPicker Drivers="all"
                Followed="Follows.DriverIds"
                OnToggle="ToggleFollow"
                OnDone="() => editing = false" />
}
else
{
  <div class="toolbar">
    <h1>Watching <span class="count">@Watched.Count</span></h1>

    <div class="controls">
      <div class="segmented" role="group" aria-label="View">
        <button class="@(Follows.View == "consolidated" ? "active" : "")"
                aria-pressed="@(Follows.View == "consolidated")"
                @onclick='() => Follows.SetViewAsync("consolidated")'>Consolidated</button>
        <button class="@(Follows.View == "series" ? "active" : "")"
                aria-pressed="@(Follows.View == "series")"
                @onclick='() => Follows.SetViewAsync("series")'>By series</button>
      </div>
      <button class="edit" @onclick="() => editing = true">Edit</button>
    </div>
  </div>

  <div class="list">
    @if (Follows.View == "series")
    {
      @foreach (var group in BySeries)
      {
        <div class="group-head" style="--accent: @SeriesInfo.Accent(group.Key)">
          @SeriesInfo.Name(group.Key)
        </div>
        @foreach (var r in group)
        {
          <DriverRow Result="r" OnSelect="Open" />
        }
      }
    }
    else
    {
      @foreach (var r in Consolidated)
      {
        <DriverRow Result="r" ShowSeries="true" OnSelect="Open" />
      }
    }
  </div>
}

@if (selected is not null)
{
  <PlayerCard @key="selected.DriverId"
              DriverId="selected.DriverId"
              Series="@selected.Series"
              OnClose="() => selected = null" />
}

@code {
  private List<LatestResult>? all;
  private string? error;
  private bool editing;
  private LatestResult? selected;

  private void Open(LatestResult r) => selected = r;

  protected override async Task OnInitializedAsync()
  {
    await Follows.LoadAsync();
    try
    {
      all = await Http.GetFromJsonAsync<List<LatestResult>>("latest-results") ?? new();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
  }

  private List<LatestResult> Watched =>
    all?.Where(r => Follows.IsFollowed(r.DriverId)).ToList() ?? new();

  // Most recent race first, then finishing position.
  private IEnumerable<LatestResult> Consolidated =>
    Watched.OrderByDescending(r => r.StartTime).ThenBy(r => SortKey(r.Position));

  // Series with the most recent race first; same ordering inside each series.
  private IEnumerable<IGrouping<string, LatestResult>> BySeries =>
    Consolidated
      .GroupBy(r => r.Series)
      .OrderByDescending(g => g.Max(r => r.StartTime));

  private Task ToggleFollow(int driverId) => Follows.ToggleAsync(driverId);

  private static int SortKey(string? position) =>
    int.TryParse(position, out var p) ? p : int.MaxValue;
}
